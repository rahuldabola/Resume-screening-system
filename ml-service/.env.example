# Origins allowed to call this service from a browser. Only the Node backend is
# supposed to reach it, and that call is server to server, where CORS does not
# apply — this is a guard against a stray public deployment being callable from
# any page on the web.
ALLOWED_ORIGINS=http://localhost:4000

# Bind address and port. Defaults suit local runs and docker-compose; a platform
# that assigns the port sets PORT, and Railway's IPv6-only private network needs
# HOST=::
# HOST=0.0.0.0
# PORT=8000
