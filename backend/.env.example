PORT=4000
ML_SERVICE_URL=http://localhost:8000

# Comma-separated list of browser origins allowed to call this API. A deployed
# frontend often answers on more than one hostname, and CORS matches exactly.
CLIENT_ORIGIN=http://localhost:5173

# Optional: override where the SQLite file is written (defaults to backend/screening.db)
# DATABASE_PATH=./screening.db

# Set to true only when running behind a platform proxy (Railway, Render, Fly).
# It makes the per-IP rate limit key on the first X-Forwarded-For hop instead of
# the proxy's own address. Leave unset locally: trusting the header when nothing
# sets it lets a client forge its own rate-limit key.
# TRUST_PROXY=true
